#!/bin/bash

BLUE='\033[38;2;137;180;250m'
LAVENDER='\033[38;2;180;190;254m'
GREEN='\033[38;2;166;227;161m'
YELLOW='\033[38;2;249;226;175m'
PINK='\033[38;2;245;194;231m'
DIM='\033[38;2;108;112;134m'
RESET='\033[0m'
BOLD='\033[1m'

# System info
KERNEL=$(uname -r)
UPTIME=$(uptime -p | sed 's/up //')
PACKAGES=$(pacman -Q | wc -l)
SHELL_NAME=$(basename $SHELL)
MEM_USED=$(free -h | awk '/Mem:/ {print $3}')
MEM_TOTAL=$(free -h | awk '/Mem:/ {print $2}')
CPU_TEMP=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null | awk '{printf "%.0f°C", $1/1000}')
DISK_USED=$(df -h / | awk 'NR==2 {print $3 "/" $2}')
DATE=$(date '+%A, %d %B %Y')
TIME=$(date '+%H:%M')

clear

echo ""
echo ""
echo ""
echo -e "                ${BLUE}${BOLD}                  -\`"
echo -e "                ${BLUE}                 .o+\`"
echo -e "                ${BLUE}                \`ooo/"
echo -e "                ${BLUE}               \`+oooo:"
echo -e "                ${BLUE}              \`+oooooo:"
echo -e "                ${BLUE}              -+oooooo+:"
echo -e "                ${BLUE}            \`/:-:++oooo+:"
echo -e "                ${BLUE}           \`/++++/+++++++:"
echo -e "                ${BLUE}          \`/++++++++++++++:"
echo -e "                ${BLUE}         \`/+++o${LAVENDER}oooooooo${BLUE}oooo/\`"
echo -e "                ${LAVENDER}        ./${BLUE}ooo${LAVENDER}ooooooooooooooo/\`"
echo -e "                ${LAVENDER}       .+oooooooooooooooooooo/\`"
echo -e "                ${LAVENDER}      .+oooooo/-${RESET}${DIM}----------${LAVENDER}-:++oo/\`"
echo -e "                ${LAVENDER}     .+oooooo/${RESET}                ${LAVENDER}\`:+oo/."
echo -e "                ${LAVENDER}    .+oooooo/${RESET}                  ${LAVENDER}\`:+oo:."
echo -e "                ${LAVENDER}   .+oooooo/${RESET}                    ${LAVENDER}\`:+oo/."
echo -e "                ${RESET}"
echo ""
echo -e "         ${BLUE}${BOLD}A R C H   L I N U X${RESET}   ${DIM}───────────────────${RESET}"
echo ""
echo -e "         ${BLUE} ${RESET} ${BOLD}$USER${RESET}${DIM}@${RESET}${BOLD}$(cat /etc/hostname)${RESET}"
echo -e "         ${GREEN} ${RESET} Kernel    ${DIM}$KERNEL${RESET}"
echo -e "         ${YELLOW} ${RESET} Uptime    ${DIM}$UPTIME${RESET}"
echo -e "         ${PINK}󰏗 ${RESET} Packages  ${DIM}$PACKAGES${RESET}"
echo -e "         ${LAVENDER} ${RESET} Shell     ${DIM}$SHELL_NAME${RESET}"
echo -e "         ${BLUE} ${RESET} Memory    ${DIM}$MEM_USED / $MEM_TOTAL${RESET}"
echo -e "         ${GREEN}󰋊 ${RESET} Disk      ${DIM}$DISK_USED${RESET}"
echo -e "         ${YELLOW} ${RESET} Temp      ${DIM}$CPU_TEMP${RESET}"
echo ""
echo -e "         ${DIM}$DATE  $TIME${RESET}"
echo ""
echo ""
