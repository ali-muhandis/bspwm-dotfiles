#!/bin/bash
# Focus Telegram window and switch to its desktop
TELEGRAM_ID=$(bspc query -N -n .window | while read wid; do
    if xprop -id "$wid" WM_CLASS 2>/dev/null | grep -qi "telegram"; then
        echo "$wid"
        break
    fi
done)

if [ -n "$TELEGRAM_ID" ]; then
    bspc node "$TELEGRAM_ID" -f
fi
